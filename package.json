{
  "name": "markdown-review",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first Markdown review surface with queued, line-anchored feedback for MCP Apps hosts.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjs-w/markdown-review.git"
  },
  "homepage": "https://github.com/tjs-w/markdown-review#readme",
  "bugs": {
    "url": "https://github.com/tjs-w/markdown-review/issues"
  },
  "keywords": [
    "codex",
    "markdown",
    "mcp",
    "mcp-apps",
    "typescript",
    "review"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:check": "bun scripts/build.ts --check",
    "browser:harness": "bun tests/harness/browser-harness.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "bun test packages web/src/*.test.ts tests/integration tests/property scripts/*.test.ts",
    "test:coverage": "bun test --coverage packages web/src/*.test.ts tests/integration tests/property scripts/*.test.ts && bun scripts/check-coverage.ts",
    "test:e2e": "playwright test --project=chromium --project=webkit --project=mobile-chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "validate:skill": "bun scripts/validate-package.ts skill",
    "validate:plugin": "bun scripts/validate-package.ts plugin",
    "security:audit": "bun audit --audit-level=high",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test:coverage && bun run build:check && bun run validate:skill && bun run validate:plugin",
    "verify": "bun run check && bun run test:e2e"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fast-png": "^8.0.0",
    "marked": "^18.0.10",
    "sanitize-html": "^2.17.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.34.0",
    "@happy-dom/global-registrator": "^20.0.8",
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@types/bun": "^1.2.21",
    "@types/node": "^22.0.0",
    "@types/sanitize-html": "^2.16.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.34.0",
    "fast-check": "^4.3.0",
    "happy-dom": "^20.0.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  }
}
